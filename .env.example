# Vercel build environment for the Rose App live demo
# Set these in Vercel -> Project Settings -> Environment Variables.
# Each app's src/environments/environment.ts is rewritten during the build
# (see scripts/prepare-vercel-bundle.mjs). If unset, safe defaults are used.

# Public host of the shell (used for i18n loader + auth redirects).
# Defaults to https://${VERCEL_PROJECT_PRODUCTION_URL}.
SHELL_URL=https://rose-app-demo.vercel.app

# Backend API base URL.
API_URL=https://rose-app.elevate-bootcamp.cloud/api/

# Google Maps JS API key. Leave empty to disable maps.
# NOTE: if the key is HTTP-referrer-restricted to localhost, maps will not
# load on the demo domain.
MAPS_API_KEY=